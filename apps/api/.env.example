# Server configuration
PORT=5000
NODE_ENV=development

# Allowed CORS client origin
CLIENT_URL=http://localhost:5173

# LiveKit Cloud Configuration (keep secret, never expose to client)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Neon Serverless PostgreSQL Configuration (keep secret, never expose to client)
# Pooled connection string (recommended for web application traffic, routes through PgBouncer)
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint-id>-pooler.<region>.aws.neon.tech/relay?sslmode=require

# Direct unpooled connection string (used for schema migrations and DDL operations)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@<endpoint-id>.<region>.aws.neon.tech/relay?sslmode=require

# Optional pool configuration overrides
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# AI Meeting Assistant Configuration (keep secret, never expose to frontend)
AI_ASSISTANT_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# AI Models and Cost Controls (optional overrides)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
TRANSCRIPTION_PROVIDER=gemini
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe


# Cost & Rate Limits
AI_SUMMARY_MIN_CHARS=400
AI_SUMMARY_COOLDOWN_MS=300000
AI_MAX_SUMMARIES_PER_MEETING=10
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_MEETING_DURATION_MS=7200000

