{
  "name": "relay-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay — AI-Powered Video Conferencing Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"npm run dev -w @relay/api\" \"npm run dev -w @relay/web\"",
    "dev:api": "npm run dev -w @relay/api",
    "dev:web": "npm run dev -w @relay/web",
    "build": "npm run build -w @relay/web",
    "test": "npm run test -w @relay/api && npm run test -w @relay/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.15.0",
    "prettier": "^3.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
